{
  "description": "Fast, local Codex safety and repository-context hooks.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks.mjs\"",
            "timeout": 5,
            "statusMessage": "Loading repository context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking prompt safety"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking command safety"
          }
        ]
      },
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking edit safety"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks.mjs\"",
            "timeout": 5,
            "statusMessage": "Reviewing edit safety"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking version bump..."
          }
        ]
      }
    ]
  }
}
