{
  "schemaVersion": 1,
  "benchmark": "ai-context-engine",
  "repo": "astrograph",
  "repoSha": "7c59a965a26c9840e388155f2e30989e6b559390",
  "tokenizer": "cl100k_base",
  "tasks": [
    {
      "id": "task-corpus-loader",
      "path": "tasks/task-corpus-loader.md",
      "slice": "bench",
      "workflows": ["baseline", "symbol-first"],
      "allowedPaths": ["bench/src/corpus.ts"],
      "targets": [
        {
          "kind": "symbol",
          "value": "loadBenchmarkCorpus",
          "mode": "exact"
        }
      ]
    },
    {
      "id": "task-runner-artifacts",
      "path": "tasks/task-runner-artifacts.md",
      "slice": "bench",
      "workflows": ["baseline", "symbol-first"],
      "allowedPaths": [
        "bench/src/runner.ts",
        "bench/src/report.ts"
      ],
      "targets": [
        {
          "kind": "symbol",
          "value": "runBenchmark",
          "mode": "exact"
        }
      ]
    },
    {
      "id": "task-token-accounting",
      "path": "tasks/task-token-accounting.md",
      "slice": "bench",
      "workflows": ["baseline", "symbol-first"],
      "allowedPaths": [
        "bench/src/tokenizer.ts",
        "bench/src/workflows.ts"
      ],
      "targets": [
        {
          "kind": "symbol",
          "value": "countTokens",
          "mode": "exact"
        }
      ]
    },
    {
      "id": "task-cli-entrypoint",
      "path": "tasks/task-cli-entrypoint.md",
      "slice": ".",
      "workflows": ["baseline", "symbol-first"],
      "allowedPaths": [
        "bench/src/cli.ts",
        "package.json"
      ],
      "targets": [
        {
          "kind": "symbol",
          "value": "main",
          "mode": "exact"
        }
      ]
    },
    {
      "id": "task-bundle-workflow",
      "path": "tasks/task-bundle-workflow.md",
      "slice": "bench",
      "workflows": ["baseline", "bundle"],
      "allowedPaths": ["bench/src/workflows.ts"],
      "targets": [
        {
          "kind": "symbol",
          "value": "taskContextWorkflow",
          "mode": "exact"
        }
      ]
    },
    {
      "id": "task-strict-snapshot",
      "path": "tasks/task-strict-snapshot.md",
      "slice": "bench",
      "workflows": ["baseline", "symbol-first"],
      "allowedPaths": [
        "bench/src/runner.ts",
        "bench/src/snapshot.ts"
      ],
      "targets": [
        {
          "kind": "symbol",
          "value": "assertStrictSnapshot",
          "mode": "exact"
        }
      ]
    }
  ]
}
