{
  "name": "astrograph",
  "version": "0.10.3-alpha.202",
  "type": "module",
  "license": "MIT",
  "description": "Local deterministic context engine for AI-assisted code exploration",
  "keywords": [
    "astrograph",
    "mcp",
    "code-indexing",
    "code-search",
    "local-first",
    "sqlite"
  ],
  "homepage": "https://github.com/mortenbroesby/astrograph",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mortenbroesby/astrograph.git"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "bugs": {
    "url": "https://github.com/mortenbroesby/astrograph/issues"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "astrograph": "dist/astrograph.js"
  },
  "files": [
    "README.md",
    "LICENSE",
    "assets/astrograph-logo.svg",
    "dist",
    "src/scripts/global-install-message.mjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prepare": "husky",
    "build": "tsdown",
    "cli": "node ./dist/cli.js",
    "mcp": "node --no-warnings ./dist/mcp.js",
    "git-refresh": "node ./dist/scripts/git-smart-refresh.js",
    "dev:cli": "node --import=tsx ./src/cli.ts",
    "dev:mcp": "node --no-warnings --import=tsx ./src/mcp.ts",
    "prebench:small": "pnpm build",
    "bench:small": "node --import=tsx ./bench/scripts/benchmark-small.mjs",
    "prebench:cli": "pnpm build",
    "bench:cli": "node --import=tsx ./bench/scripts/benchmark-cli.mjs",
    "prebench:corpus": "pnpm build",
    "bench:corpus": "node --import=tsx ./bench/src/cli.ts",
    "prebench:tokenizer-research": "pnpm build",
    "bench:tokenizer-research": "node --import=tsx ./bench/src/tokenizer-research.ts",
    "prebench:perf": "pnpm build",
    "bench:perf": "node --import=tsx ./bench/scripts/perf.mjs",
    "prebench:perf:index": "pnpm build",
    "bench:perf:index": "node --import=tsx ./bench/scripts/perf-index.mjs",
    "prebench:perf:query": "pnpm build",
    "bench:perf:query": "node --import=tsx ./bench/scripts/perf-query.mjs",
    "prebench:perf:daemon": "pnpm build",
    "bench:perf:daemon": "node --import=tsx ./bench/scripts/perf-daemon.mjs",
    "prebench:freshness-lifecycle": "pnpm build",
    "bench:freshness-lifecycle": "node --import=tsx ./bench/scripts/measure-freshness-lifecycle.mjs",
    "prebench:mcp-envelopes": "pnpm build",
    "bench:mcp-envelopes": "node --import=tsx ./bench/scripts/measure-mcp-envelopes.mjs",
    "prebench:agc1-compact-output": "pnpm build",
    "bench:agc1-compact-output": "node --import=tsx ./bench/scripts/measure-agc1-compact-output-matrix.mjs",
    "profile:index:clinic": "clinic flame --dest .profiles/clinic/index --name astrograph-index -- node --import=tsx ./bench/scripts/perf-index.mjs",
    "profile:query:clinic": "clinic doctor --dest .profiles/clinic/query --name astrograph-query -- node --import=tsx ./bench/scripts/perf-query.mjs",
    "profile:index:0x": "0x --output-dir .profiles/0x/index -- node --import=tsx ./bench/scripts/perf-index.mjs",
    "profile:query:0x": "0x --output-dir .profiles/0x/query -- node --import=tsx ./bench/scripts/perf-query.mjs",
    "test:package-bin": "node --import=tsx ./src/scripts/smoke-package-bin.ts",
    "test:package-bin:prebuilt": "node --import=tsx ./src/scripts/smoke-package-bin.ts --prebuilt",
    "check:version-bump": "node --import=tsx ./src/scripts/check-version-bump.ts",
    "release": "pnpm release:apply && pnpm test",
    "release:plan": "node ./dist/scripts/release-agent.js",
    "release:apply": "node ./dist/scripts/release-agent.js --apply",
    "type-lint": "pnpm run type-check && tsc -p ./bench/tsconfig.json --noEmit",
    "type-check": "tsc --noEmit",
    "lint:runtime": "oxlint src/scripts/install.ts src/scripts/release-agent.ts src/scripts/run-vitest.ts",
    "test": "node --import=tsx ./src/scripts/run-vitest.ts",
    "test:slow": "ASTROGRAPH_ENABLE_SLOW_TESTS=1 node --import=tsx ./src/scripts/run-vitest.ts",
    "hooks:pre-commit": "node ./scripts/pre-commit-hook.mjs",
    "hooks:pre-push": "node ./scripts/prepush-checks.mjs",
    "hooks:post-merge": "node ./scripts/post-merge-hook.mjs",
    "agents:check": "node ./scripts/agent-contract.mjs check",
    "skills:list": "node ./scripts/agent-contract.mjs skills:list",
    "skills:search": "node ./scripts/agent-contract.mjs skills:search",
    "skills:read": "node ./scripts/agent-contract.mjs skills:read",
    "skills:route": "node ./scripts/agent-contract.mjs skills:route",
    "ralph:init": "node scripts/ralph/init.mjs",
    "ralph:loop": "node scripts/ralph/loop.mjs",
    "prepack": "pnpm run build",
    "postinstall": "node ./src/scripts/global-install-message.mjs"
  },
  "devDependencies": {
    "0x": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.1",
    "@types/picomatch": "^4.0.3",
    "@types/semver": "7.7.1",
    "clinic": "^13.0.0",
    "gpt-tokenizer": "3.4.0",
    "husky": "^9.1.7",
    "js-tiktoken": "1.0.21",
    "oxlint": "^1.75.0",
    "tinybench": "^6.0.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@node-rs/xxhash": "^1.7.6",
    "@parcel/watcher": "^2.5.6",
    "@vscode/ripgrep": "^1.17.1",
    "better-sqlite3": "^12.11.1",
    "commander": "^14.0.3",
    "execa": "9.6.1",
    "fdir": "^6.5.0",
    "jiti": "2.7.0",
    "p-map": "^7.0.4",
    "picomatch": "^4.0.4",
    "pino": "^10.3.1",
    "piscina": "^5.1.4",
    "semver": "7.8.5",
    "tiktoken": "^1.0.22",
    "tokenx": "^1.3.0",
    "@astrograph/tree-sitter": "npm:tree-sitter@0.25.0",
    "tree-sitter-bash": "0.25.1",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-c-sharp": "0.23.5",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-css": "^0.25.0",
    "tree-sitter-embedded-template": "^0.25.0",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-html": "^0.23.2",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-json": "^0.24.8",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-powershell": "0.26.4",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-scala": "^0.24.0",
    "tree-sitter-typescript": "0.23.2",
    "zod": "^4.3.6"
  },
  "packageManager": "pnpm@9.15.9"
}
